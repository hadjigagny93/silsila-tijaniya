# Application de bureau et développement local : fichier de la base SQLite.
SQLITE_PATH=data/silsila.db

# Mise en ligne : Supabase (Project Settings > API), sans SQLITE_PATH.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Publication depuis le Mac (npm run publier), dans .env.local seulement : jamais sur Vercel ni dans le code.
SUPABASE_SERVICE_ROLE_KEY=
