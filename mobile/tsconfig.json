{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "../src/*"
      ]
    },
    "plugins": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "src/env.d.ts"
  ],
  "exclude": [
    "dist",
    "ios"
  ]
}
